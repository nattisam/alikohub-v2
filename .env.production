# ============================================
# AlikoHub VPS Production Environment Template
# ============================================
# Copy this file to .env and fill in your production values
# NEVER commit the actual .env file with real credentials!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Use PostgreSQL schemas to isolate microservice data
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA_NAME

AUTH_DATABASE_URL="postgresql://alikohub_user:CHANGE_ME@localhost:5432/alikohub?schema=auth"
ACADEMY_DATABASE_URL="postgresql://alikohub_user:CHANGE_ME@localhost:5432/alikohub?schema=academy"
CONTECH_DATABASE_URL="postgresql://alikohub_user:CHANGE_ME@localhost:5432/alikohub?schema=contech"
CAREERS_DATABASE_URL="postgresql://alikohub_user:CHANGE_ME@localhost:5432/alikohub?schema=careers"
EVENTS_DATABASE_URL="postgresql://alikohub_user:CHANGE_ME@localhost:5432/alikohub?schema=events"

# ===========================================
# RABBITMQ CONFIGURATION (Optional)
# ===========================================
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_ENABLED="true"

# ===========================================
# MICROSERVICES PORTS
# ===========================================
# These ports are used for internal communication
# Only API_GATEWAY_PORT should be exposed externally (via Nginx)

API_GATEWAY_PORT=3006
AUTH_SERVICE_PORT=3001
AUTH_TCP_PORT=3011
FILE_UPLOAD_SERVICE_PORT=3009
ACADEMY_SERVICE_PORT=3005
CONTECH_SERVICE_PORT=3002
CAREERS_SERVICE_PORT=3008
EVENTS_SERVICE_PORT=3004

# ===========================================
# SERVICE HOSTS (for inter-service communication)
# ===========================================
AUTH_SERVICE_HOST=127.0.0.1
ACADEMY_SERVICE_HOST=127.0.0.1
CONTECH_SERVICE_HOST=127.0.0.1
CAREERS_SERVICE_HOST=127.0.0.1
EVENTS_SERVICE_HOST=127.0.0.1
FILE_UPLOAD_SERVICE_HOST=127.0.0.1

# ===========================================
# SECURITY & JWT
# ===========================================
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_SERVICE_ACCOUNT_PATH="/opt/alikohub/firebase-service-account.json"

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@alikohub.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="AlikoHub <noreply@alikohub.com>"

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
# For local storage on VPS
UPLOAD_DRIVER="local"
UPLOAD_PATH="/opt/alikohub/uploads"
MAX_FILE_SIZE=10485760

# For AWS S3 (optional)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="alikohub-uploads"

# ===========================================
# FRONTEND URLs (for CORS and redirects)
# ===========================================
FRONTEND_URL="https://alikohub.com"
ACADEMY_FRONTEND_URL="https://academy.alikohub.com"
CONTECH_FRONTEND_URL="https://contech.alikohub.com"
EVENTS_FRONTEND_URL="https://events.alikohub.com"
CAREERS_FRONTEND_URL="https://careers.alikohub.com"

# ===========================================
# CAPTCHA (Optional)
# ===========================================
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# ===========================================
# APPLICATION MODE
# ===========================================
NODE_ENV="production"
