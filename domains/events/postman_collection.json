								},
								{
									"key": "startTime",
									"value": "09:00",
									"type": "text"
								},
								{
									"key": "location",
									"value": "Convention Center & Zoom",
									"type": "text"
								},
								{
									"key": "coverImage",
									"type": "file",
									"src": [],
