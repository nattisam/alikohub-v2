							"raw": "{{base_url}}/manage/events/{{post_id}}/submit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"manage",
								"events",
								"{{post_id}}",
								"submit"
							]
						},
						"description": "Changes status to PENDING."
					},
					"response": []
				}
			]
		},
