						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Updated Tech Summit Title\",\n    \"content\": \"Updated content...\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/manage/events/{{post_id}}",
							"host": [
								"{{base_url}}"
