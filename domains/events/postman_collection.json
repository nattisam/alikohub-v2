{
	"info": {
		"_postman_id": "aliko-events-v1",
		"name": "Aliko Events API",
		"description": "Collection for Aliko Events platform including Public, Content Manager, and Admin workflows.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Public API",
			"item": [
				{
					"name": "Get Published Feed",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/events?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"events"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "type",
									"value": "EVENT",
									"description": "Optional: EVENT, ANNOUNCEMENT, NEWS",
									"disabled": true
								}
							]
						},
						"description": "Public feed of published content."
					},
					"response": []
				},
				{
					"name": "Get Post Detail",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/events/{{post_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"events",
								"{{post_id}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Submit Promotion Request",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"companyName\": \"Tech Giants Inc\",\n    \"contactPerson\": \"John Doe\",\n    \"email\": \"john@techgiants.com\",\n    \"phoneNumber\": \"+1234567890\",\n    \"type\": \"EVENT\",\n    \"message\": \"We would like to promote our upcoming JS conference.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/events/promote",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"events",
								"promote"
							]
						}
					},
					"response": []
				}
			]
		},
		{
