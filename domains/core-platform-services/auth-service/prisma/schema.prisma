generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                   @id @default(autoincrement())
  firebaseId           String                @unique
  firstname            String
  lastname             String?
  email                String                @unique
  password             String?
  globalRole           GlobalRole            @default(USER)
  profilePicture       String?
  bio                  String?
  status               String                @default("ACTIVE")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  academyUser          AcademyUser?
  application          Application[]
  consultancyUser      ConsultancyUser?
  contechUser          ContechUser?
  eventsUser           EventsUser?
}

model Application {
  id            Int               @id @default(autoincrement())
  userId        String
  domain        String
  requestedRole String
  formData      Json
  status        ApplicationStatus @default(PENDING)
  reviewedBy    String?
  reviewNotes   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [firebaseId])

  @@unique([userId, domain])
}



model ConsultancyUser {
  id             String          @id @default(cuid())
  userId         String          @unique
  role           ConsultancyRole
  university     String?
  country        String?
  educationLevel String?
  specialization String?
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [firebaseId])
}

model AcademyUser {
  id              String      @id @default(cuid())
  userId          String      @unique
  role            AcademyRole
  status          String      @default("ACTIVE")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [firebaseId])
}

model ContechUser {
  id        String      @id @default(cuid())
  userId    String      @unique
  role      ContechRole
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [firebaseId])
}

model EventsUser {
  id               String     @id @default(cuid())
  userId           String     @unique
  role             EventsRole
  status           String     @default("ACTIVE")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [firebaseId])
}

enum GlobalRole {
  USER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}



enum AcademyRole {
  USER
  STUDENT
  INSTRUCTOR
  COURSE_MANAGER
  ADMIN
}

enum ConsultancyRole {
  USER
  STUDENT
  ADVISOR
  PARTNER_INSTITUTION
  ADMIN
}

enum ContechRole {
  USER
  CLIENT
  CONTRACTOR
  PROJECT_MANAGER
  STAKEHOLDER
  ADMIN
}

enum EventsRole {
  USER
  ATTENDEE
  ORGANIZER
  SPONSOR
  ADMIN
}
