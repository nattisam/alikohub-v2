generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id                Int               @id @default(autoincrement())
  amount            Float
  currency          String            @default("USD")
  provider          PaymentProvider
  status            TransactionStatus @default(PENDING)
  reference         String            @unique // Internal unique reference
  providerReference String?           @unique // Reference from Chapa/Stripe
  metadata          Json?
  userId            String?           // User who initiated the transaction
  purpose           String?           // e.g., "SUBSCRIPTION", "COURSE_PURCHASE"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([reference])
}

enum PaymentProvider {
  CHAPA
  STRIPE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}
