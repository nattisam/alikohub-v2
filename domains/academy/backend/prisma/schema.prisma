generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademyProfile {
  id              Int         @id @default(autoincrement())
  userId          String      @unique
  role            AcademyRole @default(STUDENT)
  hasSelectedRole Boolean     @default(false) // Add this field

  bio       String?
  expertise String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course            Course[]
  enrollments       Enrollment[]
  notification      Notification[]
  progress          Progress[]
  // NEW: Add relation to teaching schedules
  teachingSchedules TeachingSchedule[]
}

model Course {
  id               Int            @id @default(autoincrement())
  title            String
  thumbnail        String?
  shortDescription String?
  longDescription  String?
  category         String?
  instructorId     String // userId from auth service
  profile          AcademyProfile @relation(fields: [instructorId], references: [userId])
  status           CourseStatus
  skills           String[]
  conceptsLearned  String[]
  estimatedTime    Int?
  targetLevel      String?
  enrolledNum      Int? // Changed from String? to Int?
  rating           Int?
  price            Int?
  prerequisites    String[]
  languages        String[]
  cohorts          Cohort[]
  modules          Module[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  enrollments       Enrollment[]
  progress          Progress[]
  // NEW: Add relation to teaching schedules
  teachingSchedules TeachingSchedule[]
}

model Cohort {
  id          Int          @id @default(autoincrement())
  name        String
  courseId    Int
  enrollments Enrollment[]
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     String // ID from auth service
  cohortId   Int?
  courseId   Int?
  enrolledAt DateTime @default(now())
  progress   Float    @default(0.0)

  cohort  Cohort?        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course  Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  profile AcademyProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, cohortId, courseId])
}

model Module {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  courseId    Int
  lessons     Lesson[]
  progress    Progress[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id        Int        @id @default(autoincrement())
  title     String
  type      LessonType
  moduleId  Int
  contents  Content[]
  progress  Progress[]
  dueDate   DateTime?
  maxScore  Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Content {
  id        Int         @id @default(autoincrement())
  title     String
  type      ContentType
  url       String
  lessonId  Int
  progress  Progress[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Progress {
  id        Int      @id @default(autoincrement())
  userId    String // ID from auth service
  courseId  Int
  moduleId  Int?
  lessonId  Int?
  contentId Int?
  status    String
  score     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  course  Course         @relation(fields: [courseId], references: [id])
  module  Module?        @relation(fields: [moduleId], references: [id])
  lesson  Lesson?        @relation(fields: [lessonId], references: [id])
  content Content?       @relation(fields: [contentId], references: [id])
  profile AcademyProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

// NEW: TeachingSchedule model
model TeachingSchedule {
  id                Int          @id @default(autoincrement())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  type              ScheduleType
  courseId          Int
  instructorId      String // userId from auth service
  isRecurring       Boolean      @default(false)
  recurrencePattern String? // For recurring schedules (e.g., "WEEKLY", "DAILY")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  profile AcademyProfile @relation(fields: [instructorId], references: [userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  profile AcademyProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

enum LessonType {
  VIDEO
  WEBINAR
  ASSIGNMENT
  QUIZ
}

enum ContentType {
  VIDEO
  PDF
  QUIZ
  ASSIGNMENT
}

// NEW: ScheduleType enum
enum ScheduleType {
  LIVE
  RECORDING
  Q_AND_A
  OFFICE_HOURS
  WORKSHOP
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AcademyRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}
