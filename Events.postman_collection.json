			]
		},
		{
			"name": "Auth Service (Admin)",
			"item": [
				{
					"name": "Create Content Manager User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"manager@example.com\",\n    \"firstname\": \"Jane\",\n    \"lastname\": \"Manager\",\n    \"password\": \"Manager123!\",\n    \"role\": \"CONTENT_MANAGER\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/events/user",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"events",
								"user"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3006",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "PASTE_ADMIN_TOKEN_HERE",
			"type": "string"
		},
		{
			"key": "managedToken",
			"value": "PASTE_CONTENT_MANAGER_TOKEN_HERE",
			"type": "string"
		},
		{
			"key": "postId",
			"value": "UUID_OF_POST",
			"type": "string"
		},
		{
