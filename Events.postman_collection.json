{
	"info": {
		"_postman_id": "e2f3g4h5-i6j7-k8l9-m0n1-o2p3q4r5s6t7",
		"name": "Aliko Events API",
		"description": "Simplified publishing platform for Aliko Events, Announcements, and News.\n\nRoles:\n- **ADMIN**: Content review (publish/reject), manage promotion requests, create content managers.\n- **CONTENT_MANAGER**: Create drafts, update owned content, submit for review.\n- **PUBLIC**: Read-only access to published content, submit promotion requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Public Endpoints",
			"item": [
				{
					"name": "List All Published Posts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/events?type=EVENT&page=1&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events"
							],
							"query": [
								{
									"key": "type",
									"value": "EVENT",
									"description": "Optional: EVENT, ANNOUNCEMENT, NEWS"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Published Post Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/events/{{postId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events",
								"{{postId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Submit Promotion Request",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"companyName\": \"Aliko Tech Solutions\",\n    \"contactPerson\": \"Jane Doe\",\n    \"email\": \"jane@alikotech.com\",\n    \"phoneNumber\": \"+2348012345678\",\n    \"description\": \"I would like to promote our new AI software at the next tech event.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/events/promote",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events",
								"promote"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Internal Management",
			"item": [
				{
					"name": "Create Post (Draft)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managedToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"EVENT\",\n    \"title\": \"Tech Summit 2024\",\n    \"excerpt\": \"The biggest tech gathering in the region.\",\n    \"content\": \"<h1>Details</h1><p>Join us for a day of innovation...</p>\",\n    \"eventDate\": \"2024-12-01T09:00:00Z\",\n    \"startTime\": \"09:00 AM\",\n    \"endTime\": \"05:00 PM\",\n    \"location\": \"Virtual/Lagos\",\n    \"externalLink\": \"https://techsummit.aliko.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/manage/events",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"manage",
								"events"
							]
						}
					},
					"response": []
				},
				{
					"name": "List Management Posts",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managedToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/manage/events?status=PENDING",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"manage",
								"events"
							],
							"query": [
								{
									"key": "status",
									"value": "PENDING",
									"description": "Optional: DRAFT, PENDING, APPROVED, PUBLISHED, REJECTED"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Update Post",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managedToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Updated Tech Summit 2024 Title\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/manage/events/{{postId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"manage",
								"events",
								"{{postId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Submit for Review",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managedToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/manage/events/{{postId}}/submit",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"manage",
								"events",
								"{{postId}}",
								"submit"
							]
						}
					},
					"response": []
				},
				{
					"name": "Review Post (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"PUBLISHED\",\n    \"rejectionReason\": null\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/manage/events/{{postId}}/review",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"manage",
								"events",
								"{{postId}}",
								"review"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Post",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managedToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/manage/events/{{postId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"manage",
								"events",
								"{{postId}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin Only (Promotions)",
			"item": [
				{
					"name": "List Promotion Requests",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/manage/events/promotions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"manage",
								"events",
								"promotions"
							]
						}
					},
					"response": []
				},
				{
					"name": "Review Promotion Request",
					"request": {
						"method": "PATCH",
						"header": [
